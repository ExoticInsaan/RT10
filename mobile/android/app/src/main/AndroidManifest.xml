<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Google sign-in comes back to the app here: online.toppershelf.app://auth -->
                <data android:scheme="online.toppershelf.app" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- Small icon and colour for notifications sent from Firebase -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_toppershelf" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_blue" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="toppershelf_default" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget: days left until the next countdown (CountdownWidgetProvider.java). Needs no permission. -->
        <receiver android:name=".CountdownWidgetProvider" android:exported="false" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/countdown_widget_info" />
        </receiver>
    </application>

    <!-- Android 11+: lets the app see whether Instagram and WhatsApp are installed, for the Story and Status buttons -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: needed to show notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The notifications plugin adds this permission. We do not need it (reminders and the timer use normal alarms), and Google Play restricts it, so it is removed. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
