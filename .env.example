# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Google Analytics 4 measurement ID. The live site already uses its own ID; leave this out locally (no tracking).
# Set it to an empty value on Vercel to switch analytics off.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

